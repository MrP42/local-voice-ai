{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-voice.invalid/schemas/lva.assistent/1.json",
  "title": "Assistenten-Profil",
  "description": "Dokumentation des Assistenten-Profils lva.assistent/1. Die beiden Kerne (Swift und TypeScript) prüfen von Hand und liefern Fehler mit Pfad und Code; dieses Schema beschreibt dasselbe und wird nicht zur Laufzeit ausgewertet. Längen zählen in Unicode-Codepunkten, nicht in UTF-16-Einheiten. Unbekannte Felder sind überall erlaubt und bleiben erhalten.",
  "type": "object",
  "required": ["schema", "id", "name"],
  "properties": {
    "schema": {
      "const": "lva.assistent/1",
      "description": "Genau diese Fassung. Eine höhere Hauptversion lva.assistent/<n> mit n>1 wird als schema_neuer abgewiesen, alles andere als schema_unbekannt."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Eigene Assistenten: eigen- und 12 Zeichen. Vorlagen: alles und vorlage-…"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Nach dem Entfernen von Leerzeichen an den Enden 1 bis 60 Codepunkte, ohne Steuerzeichen und Zeilenumbruch (U+0000–U+001F, U+007F–U+009F, U+2028, U+2029). Gespeichert wird der getrimmte Name."
    },
    "beschreibung": { "type": "string", "maxLength": 200, "default": "" },
    "anweisungen": {
      "type": "string",
      "maxLength": 8000,
      "default": "",
      "description": "Zeilenumbrüche erlaubt. Platzhalter: {{name}}, {{tageszeit}}, {{datum}}, {{wochentag}}, {{uhrzeit}}."
    },
    "begruessung": { "type": "string", "maxLength": 300, "default": "" },
    "sprache": {
      "type": "string",
      "pattern": "^(auto|[a-z]{2}(-[A-Z]{2})?)$",
      "default": "de"
    },
    "stimme": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120,
      "default": null
    },
    "verhalten": {
      "type": "object",
      "properties": {
        "stil": { "enum": ["natuerlich", "woertlich"], "default": "natuerlich" },
        "sprechpause": { "enum": ["kurz", "normal", "lang"], "default": "normal" },
        "unterbrechen": { "type": "boolean", "default": true },
        "nachfrage_stille_s": {
          "type": "integer",
          "default": 0,
          "description": "0 (aus) oder 5 bis 120 Sekunden Stille bis zur Nachfrage.",
          "oneOf": [{ "const": 0 }, { "minimum": 5, "maximum": 120 }]
        }
      },
      "additionalProperties": true
    },
    "wissen": {
      "type": "object",
      "properties": {
        "alle_bereiche": { "type": "boolean", "default": false },
        "bereiche": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
          "default": [],
          "description": "Bekannt: buecher, buchnotizen, ki_dokumente, besprechungen, sprachnotizen, ablage, gespraeche, kalender, vorlesen, notizbuch. Unbekannte Schlüssel, die das Muster erfüllen, bleiben erhalten und werden ignoriert."
        },
        "modus": { "enum": ["alles", "zuerst", "nur"], "default": "alles" },
        "kontexte": {
          "type": "array",
          "maxItems": 50,
          "default": [],
          "items": {
            "type": "object",
            "required": ["art", "id"],
            "properties": {
              "art": {
                "enum": ["buch", "besprechung", "sprachnotiz", "datei", "ordner", "projekt", "abschnitt"]
              },
              "id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "titel": { "type": "string", "maxLength": 200, "default": "" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "schnittstellen": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "default": [],
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    },
    "auswertung": {
      "type": "object",
      "properties": {
        "zusammenfassung": { "type": "boolean", "default": false },
        "aufgaben": { "type": "boolean", "default": false },
        "felder": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "description": "Namen eindeutig.",
          "items": {
            "type": "object",
            "required": ["name", "typ"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
              "beschreibung": { "type": "string", "maxLength": 200, "default": "" },
              "typ": { "enum": ["text", "zahl", "datum", "auswahl"] },
              "optionen": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 60 },
                "default": [],
                "description": "Bei typ auswahl Pflicht mit 2 bis 20 Einträgen."
              }
            },
            "if": { "properties": { "typ": { "const": "auswahl" } }, "required": ["typ"] },
            "then": {
              "required": ["optionen"],
              "properties": { "optionen": { "minItems": 2, "maxItems": 20 } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
