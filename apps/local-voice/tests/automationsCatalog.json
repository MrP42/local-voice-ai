  "templates": [
    {
      "definition_json": "{\r\n  \"schema\": \"lva-workflow@1\",\r\n  \"name\": \"Termin: aufzeichnen, Protokoll, Mail\",\r\n  \"description\": \"Beim Beginn eines Termins im gewählten Kalender: Aufnahme starten (erst nach Bestätigung der Einwilligung), danach Protokoll erzeugen, als Word ablegen und per Mail senden.\",\r\n  \"trigger\": {\r\n    \"type\": \"calendar.event_starting\",\r\n    \"integration\": \"cal-graph-1\",\r\n    \"lead_min\": 1,\r\n    \"only_meetings\": true\r\n  },\r\n  \"variables\": {\r\n    \"protokoll_vorlage\": {\r\n      \"type\": \"string\",\r\n      \"default\": \"kunde\",\r\n      \"description\": \"Name der Protokollvorlage\"\r\n    }\r\n  },\r\n  \"steps\": [\r\n    {\r\n      \"id\": \"rec\",\r\n      \"action\": \"recording.start\",\r\n      \"label\": \"Aufnahme starten\",\r\n      \"params\": {\r\n        \"via\": \"app-automation\",\r\n        \"stop\": \"event_end\",\r\n        \"title\": \"{{trigger.title}}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"min\",\r\n      \"action\": \"meeting.minutes\",\r\n      \"label\": \"Protokoll erzeugen\",\r\n      \"params\": { \"template\": \"{{vars.protokoll_vorlage}}\" }\r\n    },\r\n    {\r\n      \"id\": \"doc\",\r\n      \"action\": \"export.document\",\r\n      \"label\": \"Als Word ablegen\",\r\n      \"params\": {\r\n        \"format\": \"docx\",\r\n        \"target\": \"folder-onedrive-protokolle\",\r\n        \"name\": \"{{meeting.title}} – Protokoll\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"mail_me\",\r\n      \"action\": \"mail.send\",\r\n      \"label\": \"Mail an mich\",\r\n      \"params\": {\r\n        \"via\": \"m365-1\",\r\n        \"to\": \"me\",\r\n        \"subject\": \"Protokoll: {{meeting.title}}\",\r\n        \"body\": \"Das Protokoll zu „{{meeting.title}}“ liegt in {{steps.doc.path}}.\",\r\n        \"attach\": [\"{{steps.doc.path}}\"]\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"mail_all\",\r\n      \"action\": \"mail.send\",\r\n      \"label\": \"Mail an alle Teilnehmenden\",\r\n      \"when\": \"{{trigger.calendar}} == 'cal-graph-1' and trigger.external_attendees > 0\",\r\n      \"on_error\": \"continue\",\r\n      \"params\": {\r\n        \"via\": \"m365-1\",\r\n        \"to\": \"participants\",\r\n        \"subject\": \"Protokoll: {{meeting.title}}\",\r\n        \"attach\": [\"{{steps.doc.path}}\"]\r\n      }\r\n    }\r\n  ]\r\n}\r\n",
      "description": "Beim Beginn eines Termins im gewählten Kalender: Aufnahme starten (erst nach Bestätigung der Einwilligung), danach Protokoll erzeugen, als Word ablegen und per Mail senden.",
      "id": "vorlage-besprechung",
      "name": "Termin: aufzeichnen, Protokoll, Mail"
    },
    {
      "definition_json": "{\r\n  \"schema\": \"lva-workflow@1\",\r\n  \"name\": \"Eingangsordner: transkribieren, Protokoll als Word\",\r\n  \"description\": \"Landet eine Audio- oder Videodatei im Eingangsordner, wird sie transkribiert, daraus ein Protokoll erzeugt und als Word-Datei im Zielordner abgelegt.\",\r\n  \"trigger\": {\r\n    \"type\": \"folder.file_added\",\r\n    \"integration\": \"folder-eingang\",\r\n    \"extensions\": [\"wav\", \"mp3\", \"m4a\", \"mp4\", \"mkv\"]\r\n  },\r\n  \"variables\": {\r\n    \"protokoll_vorlage\": {\r\n      \"type\": \"string\",\r\n      \"default\": \"\",\r\n      \"description\": \"Name oder Kennung der Protokollvorlage (leer: die der Besprechung bzw. die Standardvorlage; auto: nach Inhalt wählen)\"\r\n    }\r\n  },\r\n  \"steps\": [\r\n    {\r\n      \"id\": \"import\",\r\n      \"action\": \"meeting.import\",\r\n      \"label\": \"Datei importieren und transkribieren\",\r\n      \"params\": {\r\n        \"via\": \"{{trigger.integration}}\",\r\n        \"path\": \"{{trigger.path}}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"protokoll\",\r\n      \"action\": \"meeting.minutes\",\r\n      \"label\": \"Protokoll erzeugen\",\r\n      \"params\": { \"template\": \"{{vars.protokoll_vorlage}}\" }\r\n    },\r\n    {\r\n      \"id\": \"word\",\r\n      \"action\": \"export.document\",\r\n      \"label\": \"Als Word ablegen\",\r\n      \"params\": {\r\n        \"format\": \"docx\",\r\n        \"target\": \"folder-protokolle\",\r\n        \"content\": \"minutes\",\r\n        \"name\": \"{{steps.protokoll.meeting.title}} – Protokoll\"\r\n      }\r\n    }\r\n  ]\r\n}\r\n",
      "description": "Landet eine Audio- oder Videodatei im Eingangsordner, wird sie transkribiert, daraus ein Protokoll erzeugt und als Word-Datei im Zielordner abgelegt.",
      "id": "eingangsordner-word",
      "name": "Eingangsordner: transkribieren, Protokoll als Word"
    }
  ]
}
