{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tts-bench-env/1",
  "title": "TTS-Benchmark: Umgebung des Anbieters (env.json neben rows.jsonl)",
  "type": "object",
  "required": ["schema", "provider"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "tts-bench-env/1"},
    "provider": {"type": "string", "minLength": 1},
    "provider_version": {"type": ["string", "null"], "description": "z. B. Ausgabe von `ptts --version`, Fish-Serverversion"},
    "model": {"type": ["string", "null"], "description": "Modellname bzw. -datei"},
    "device": {"type": ["string", "null"], "description": "tatsaechlich genutztes Geraet: cpu | cuda | metal | remote"},
    "voice": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "app_version": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
